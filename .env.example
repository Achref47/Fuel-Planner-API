# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Required unless DJANGO_DEBUG=true. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# HTTPS hardening for a real deployment (leave off for local http://127.0.0.1:8000).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_BEHIND_HTTPS_PROXY=false
LOG_LEVEL=INFO

# SQLite file name (relative to the project root).
DATABASE_FILE=db.sqlite3

# Assessment dataset supplied by the reviewer (not included in the repository).
FUEL_CSV_PATH=data/fuel-prices-for-be-assessment.csv
# Derived place-name -> coordinate table (built by `manage.py build_gazetteer`).
GAZETTEER_PATH=data/us_places.csv.gz

# Routing provider. The public OSRM demo server is best-effort and rate limited
# (max 1 request/second); point this at a self-hosted OSRM for production use.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=15
OSRM_MIN_INTERVAL_SECONDS=1.0
# Identify your application to upstream services (required by their usage policies).
HTTP_USER_AGENT=spotter-fuel-route-assessment/1.0 (you@example.com)

ROUTE_CACHE_SECONDS=86400
GEOCODE_CACHE_SECONDS=2592000
# U.S. Census Bureau geocoder, used only for street addresses.
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
CENSUS_TIMEOUT_SECONDS=10
# Maximum entries in the in-process cache (a cached coast-to-coast route is ~0.5 MB).
CACHE_MAX_ENTRIES=200

# API rate limit per client IP (DRF format: 120/min, 1000/hour, ...).
THROTTLE_RATE=120/min
