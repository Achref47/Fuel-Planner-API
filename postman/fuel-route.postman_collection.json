    {
      "name": "5. Errors (all use the same format)",
      "item": [
        {
          "name": "Infeasible: Seattle -> San Diego (data gap)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-route/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-route",
                ""
              ]
            },
            "description": "The data has almost no stations on this corridor south of Oregon, so a 500-mile range cannot cross it. The error says where.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Seattle, WA\",\n  \"finish\": \"San Diego, CA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is no_feasible_fuel_plan\", () => pm.expect(body.error.code).to.eql(\"no_feasible_fuel_plan\"));",
                  "pm.test(\"error has message and details\", () => { pm.expect(body.error.message).to.be.a(\"string\"); pm.expect(body.error).to.have.property(\"details\"); });",
                  "pm.test(\"gap is described\", () => { pm.expect(body.error.details.shortfall_miles).to.be.above(0); pm.expect(body.error.details.gap_start).to.have.property(\"lat\"); });"
                ]
              }
            }
          ]
        },
